# Copy to .env (never commit .env). On Vercel set the same names in Project → Settings → Environment Variables.

# Organizers' dataset API (Power Automate signed URL), WITHOUT the &group_id=... part. Get it from the team chat.
CQA_API_URL='https://<org-host>/powerautomate/automations/direct/.../invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=<signature>'

# OpenRouter key (https://openrouter.ai/keys). Used only server-side by lib/openrouter.js.
OPENROUTER_API_KEY=

# OpenAI key (https://platform.openai.com/api-keys) for direct OpenAI evaluation. Used only server-side by lib/openai.js.
# Pick it with CQA_EVAL_MODEL=openai:<model id>, e.g. openai:gpt-6-luna (lib/llm.js routes the prefix to OpenAI).
OPENAI_API_KEY=

# Optional model overrides (log any change in docs/TOOLING.md)
# CQA_EVAL_MODEL=anthropic/claude-haiku-5.5
# CQA_ASR_MODEL=nvidia/nemotron-3.5-transcribe

# Optional shared store (recommended, free): ONE Upstash Redis database = shared AI cache across Vercel instances
# AND live support chats across devices. Easiest: Vercel → freedom-cqa → Storage → "Upstash for Redis" (it injects
# KV_REST_API_URL / KV_REST_API_TOKEN automatically). Manual Upstash works too:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Alternative cache backend: Cloudflare Workers KV (token permission "Workers KV Storage: Edit"):
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=

# Optional Postgres (Neon / Vercel Postgres / any server). Live /support sessions sync across devices via /api/sessions.
# Without it the UI keeps sessions in localStorage (same browser). Never commit the real URL.
# DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'
